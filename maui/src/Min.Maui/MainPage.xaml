<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Min.Maui.Models"
             xmlns:viewModels="clr-namespace:Min.Maui.ViewModels"
             x:Class="Min.Maui.MainPage"
             x:Name="Root"
             x:DataType="viewModels:BrowserShellViewModel"
             BackgroundColor="#151a21"
             Padding="0">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily"
                    Value="OpenSansSemibold"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="Padding"
                    Value="12,8"/>
            <Setter Property="BackgroundColor"
                    Value="#2c3440"/>
            <Setter Property="TextColor"
                    Value="#f5f7fb"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily"
                    Value="OpenSansRegular"/>
        </Style>
        <Style TargetType="Entry">
            <Setter Property="FontFamily"
                    Value="OpenSansRegular"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0"
              BackgroundColor="#202630"
              HeightRequest="44"
              Padding="8,0">
            <CollectionView ItemsSource="{Binding Tabs}"
                            HorizontalScrollBarVisibility="Never"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BrowserTab">
                        <Border StrokeThickness="0"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='#596b87|#303844'}"
                                HeightRequest="40"
                                WidthRequest="172"
                                Padding="8,0"
                                Margin="1,4,1,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="3,*">
                                <BoxView Color="{Binding ThemeColor}"/>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="24,*,Auto"
                                      ColumnSpacing="7"
                                      Padding="8,0">
                                    <Image Source="{Binding FaviconUrl}"
                                           WidthRequest="16"
                                           HeightRequest="16"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="0"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding DisplayTitle}"
                                               TextColor="#f5f7fb"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DisplayUrl}"
                                               TextColor="#a7b0bd"
                                               FontSize="10"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2"
                                            Text="x"
                                            FontSize="11"
                                            WidthRequest="28"
                                            HeightRequest="28"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            Command="{Binding BindingContext.CloseTabCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.SelectTabCommand, Source={x:Reference Root}}"
                                                          CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*"
              BackgroundColor="#252b34"
              HeightRequest="32"
              Padding="60,0,10,0">
            <Label Text="{Binding OverflowSummary}"
                   TextColor="#aeb7c4"
                   FontSize="12"
                   VerticalOptions="Center"/>
            <CollectionView Grid.Column="1"
                            ItemsSource="{Binding Breadcrumbs}"
                            SelectionMode="None"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:NavigationEntry">
                        <HorizontalStackLayout Spacing="6"
                                               Margin="0,0,12,0">
                            <Label Text="/"
                                   TextColor="#697483"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding Title}"
                                   TextColor="#cbd3de"
                                   FontSize="12"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.NavigateToBreadcrumbCommand, Source={x:Reference Root}}"
                                                          CommandParameter="{Binding .}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Grid.Row="2"
              BackgroundColor="#11161d">
            <Grid x:Name="WebViewHost"/>
            <VerticalStackLayout IsVisible="{Binding HasTabs, Converter={StaticResource InvertedBoolConverter}}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="14">
                <Label Text="Min"
                       TextColor="#dfe5ee"
                       FontSize="36"
                       FontFamily="OpenSansSemibold"
                       HorizontalTextAlignment="Center"/>
                <Button Text="Ask or browse"
                        Command="{Binding OpenPromptCommand}"
                        WidthRequest="180"/>
            </VerticalStackLayout>

            <Grid IsVisible="{Binding IsPromptOverlayVisible}"
                  BackgroundColor="#99000000"
                  Padding="60">
                <BoxView BackgroundColor="Transparent">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ClosePromptOverlay"/>
                    </BoxView.GestureRecognizers>
                </BoxView>
                <Border BackgroundColor="#161b22"
                        Stroke="#343d4b"
                        StrokeThickness="1"
                        Padding="0"
                        WidthRequest="720"
                        MaximumWidthRequest="820"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid RowDefinitions="Auto,*,Auto"
                          RowSpacing="0">
                        <Grid ColumnDefinitions="*,Auto"
                              Padding="16,12,12,6">
                            <Label Text="Ask Min"
                                   TextColor="#dce3ed"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                    Text="x"
                                    FontSize="14"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    TextColor="#aeb7c4"
                                    Command="{Binding ClosePromptCommand}"/>
                        </Grid>
                        <Editor x:Name="PromptEditor"
                                Grid.Row="1"
                                Text="{Binding PromptText}"
                                Placeholder="{Binding InputPlaceholder}"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="92"
                                MaximumHeightRequest="180"
                                Margin="16,0"
                                BackgroundColor="#0f141b"
                                TextColor="#f7f9fc"
                                PlaceholderColor="#8e98a6"/>
                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="10"
                              Padding="16,12,12,14">
                            <Label Text="Ctrl+L"
                                   TextColor="#7f8b99"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="1"
                                       Spacing="4"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center">
                            <Border BackgroundColor="#0f141b"
                                Stroke="#303946"
                                StrokeThickness="1"
                                Padding="3">
                                <Border.StrokeShape>
                                <RoundRectangle CornerRadius="7"/>
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="3">
                                <Button Text="Search"
                                    FontSize="12"
                                    HeightRequest="32"
                                    Padding="12,0"
                                    BackgroundColor="{Binding IsSearchMode, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='#2f3a49|#0f141b'}"
                                    TextColor="#e4ebf5"
                                    Command="{Binding SetPromptModeCommand}"
                                    CommandParameter="search"/>
                                <Button Text="Agent"
                                    FontSize="12"
                                    HeightRequest="32"
                                    Padding="12,0"
                                    BackgroundColor="{Binding IsLlmMode, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='#2f3a49|#0f141b'}"
                                    TextColor="#e4ebf5"
                                    Command="{Binding SetPromptModeCommand}"
                                    CommandParameter="agent"/>
                                </HorizontalStackLayout>
                            </Border>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2"
                                       IsVisible="{Binding IsDebugAvailable}"
                                                   Spacing="6"
                                                   VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding DebugMode}"/>
                                <Label Text="Debug"
                                       TextColor="#aeb7c4"
                                       FontSize="12"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="3"
                                    Text="{Binding SendButtonText}"
                                    BackgroundColor="{Binding IsSendFeedbackActive, Converter={StaticResource BoolToObjectConverter}, ConverterParameter='#3b82f6|#2c3440'}"
                                    Command="{Binding SubmitPromptCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,*,Auto"
              BackgroundColor="#263e63"
              HeightRequest="34"
              Padding="10,0">
            <Button Text="Ask"
                    Command="{Binding OpenPromptCommand}"
                    BackgroundColor="Transparent"/>
            <Label Grid.Column="1"
                   Text="{Binding StatusText}"
                   TextColor="#dce7f7"
                   FontSize="12"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"/>
            <Label Grid.Column="2"
                   Text="Skills ready"
                   TextColor="#dce7f7"
                   FontSize="12"
                   VerticalOptions="Center"/>
        </Grid>
    </Grid>

</ContentPage>
